rules_version = '2';

// GlottoGuess — paste into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // Each player's own progress (game history and statistics).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Duels: anyone signed in can open a duel link; only its creator can create it; immutable.
    match /duels/{duelId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.spec.game in ['guess', 'typology'];
      allow update, delete: if false;

      // One result per player, written once, by that player.
      // Visible to the duel's creator and to everyone who has finished it.
      match /results/{uid} {
        allow read: if request.auth != null && (
          request.auth.uid == uid
          || get(/databases/$(database)/documents/duels/$(duelId)).data.creatorUid == request.auth.uid
          || exists(/databases/$(database)/documents/duels/$(duelId)/results/$(request.auth.uid))
        );
        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.score is number;
        allow update, delete: if false;
      }
    }
  }
}
